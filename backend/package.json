{
  "name": "studygen-ai-backend",
  "version": "1.0.0",
  "description": "StudyGen AI — Node.js/Express REST API Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:unit": "node tests/auth.unit.test.js && node tests/studyData.unit.test.js && node tests/studyData.ownership.test.js && node tests/ai.unit.test.js && node tests/ai.security.test.js && node tests/phase5.integration.test.js && node tests/phase6.e2e.test.js && node tests/phase7.hardening.test.js",
    "test:phase2": "node tests/auth.unit.test.js",
    "test:phase3": "node tests/studyData.unit.test.js && node tests/studyData.ownership.test.js",
    "test:phase4": "node tests/ai.unit.test.js && node tests/ai.security.test.js",
    "test:phase5": "node tests/phase5.integration.test.js",
    "test:phase6": "node tests/phase6.e2e.test.js",
    "test:phase7": "node tests/phase7.hardening.test.js",
    "test:integration": "node tests/auth.integration.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
