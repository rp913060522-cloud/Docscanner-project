# ─── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS — no trailing slash)
# Development: the folder path or localhost port serving the HTML files
CLIENT_ORIGIN=http://127.0.0.1:5500

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <user>, <password>, and <cluster> with your Atlas credentials.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studygen_db?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────────────────────
# Use a long, random, secret string. Minimum 32 characters recommended.
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Obtain from Google AI Studio → API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# AI model name — change here ONLY when updating the model; code reads from this value.
GEMINI_MODEL=gemini-2.5-flash

# ── File Upload ───────────────────────────────────────────────────────────────
# Maximum allowed upload size in bytes (default: 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# Temporary file TTL in milliseconds (default: 10 minutes)
TEMP_FILE_TTL_MS=600000
